<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="뒤로"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 카드마다 따로 된 레이아웃 + 클래스라 나중에 시트 화면에서도 그대로 쓴다. -->
        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include
                android:id="@+id/cardStatus"
                layout="@layout/detail_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/cardPower"
                layout="@layout/detail_power_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/cardChart"
                layout="@layout/detail_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/cardInfo"
                layout="@layout/detail_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- 되돌리기 어려운 동작이라 맨 아래에 오류 색 글자 버튼으로 따로 둔다. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailDelete"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="기기 삭제"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorError" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
