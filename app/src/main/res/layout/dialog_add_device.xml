<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기기 종류" />
    <Spinner
        android:id="@+id/spinnerProtocol"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:entries="@array/protocol_array" /> <EditText
    android:id="@+id/editDeviceName"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="기기 이름 (예: 거실 전등)"
    android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/editPayload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="IP 주소 또는 페어링 핀코드"
        android:layout_marginTop="10dp"/>
</LinearLayout>