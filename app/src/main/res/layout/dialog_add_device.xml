<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 기기 종류 (프로토콜) 선택 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="기기 종류" />
    <Spinner
        android:id="@+id/spinnerProtocol"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:entries="@array/protocol_array" />

    <!-- 기기 이름 입력 -->
    <EditText
        android:id="@+id/editDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="기기 이름 (예: 거실 전등)"
        android:layout_marginTop="10dp"/>

    <!-- IP 또는 핀코드 입력 -->
    <EditText
        android:id="@+id/editPayload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="IP 주소 또는 페어링 핀코드"
        android:layout_marginTop="10dp"/>

    <!-- [추가됨] 부가 기능 드라이버 선택 영역 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="추가 드라이버 (선택)"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>

    <Spinner
        android:id="@+id/spinnerDriver"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:entries="@array/driver_display_array" />

    <!-- UX: 드라이버가 무엇인지 모르는 일반 사용자를 위한 안내 문구 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* PC 강제 종료 등 특수한 하드웨어 동작이 필요한 경우에만 선택하세요."
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="4dp"/>

</LinearLayout>