<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <!-- 기기 이름과 상태를 나란히 배치하기 위한 가로 컨테이너 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <!-- 🌟 개별 로딩 애니메이션 (기본 숨김) -->
            <ProgressBar
                android:id="@+id/pbDeviceLoading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />
            <!-- 기기 이름 (layout_weight="1"로 남은 공간 차지) -->
            <TextView
                android:id="@+id/tvSectionDeviceName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="거실 메인 조명"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <!-- 상태 표시 텍스트 추가 -->
            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결됨"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />
            <ImageButton
                android:id="@+id/btnEditWidgets"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="위젯 편집" />
            <!-- 🌟 새로고침 버튼 -->
            <ImageButton
                android:id="@+id/btnRefreshStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="#888888" />
        </LinearLayout>

        <!-- 🌟 DIY 위젯들이 레고처럼 조립될 빈 컨테이너 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/widgetRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.cardview.widget.CardView>