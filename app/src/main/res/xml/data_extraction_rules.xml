<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 백업·기기 이전. 암호문은 이 기기의 Keystore 키로만 풀리므로 둘 다에서 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="SecretPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="SecretPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
