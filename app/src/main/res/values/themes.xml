<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 라이트·다크가 다른 것은 이 스타일만(values-night에 같은 이름으로 다시 정의) -->
    <style name="Platform.Theme.HomeAssistantApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Material 3 색 역할을 색 토큰에 연결한다. 토큰 값은 values/values-night colors.xml이 고른다. -->
    <style name="Base.Theme.HomeAssistantApp" parent="Platform.Theme.HomeAssistantApp">
        <item name="android:colorBackground">@color/color_surface</item>
        <item name="colorOnBackground">@color/color_on_surface</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/color_surface</item>
        <item name="colorSurfaceContainerLow">@color/color_surface_container</item>
        <item name="colorSurfaceContainer">@color/color_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/color_surface_container_high</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorOutlineVariant">@color/color_divider</item>

        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        <!-- 보조·3차 색은 따로 두지 않고 강조색으로 맞춘다(하단 탭 표시기·칩이 보라색이 되지 않게) -->
        <item name="colorSecondary">@color/color_primary</item>
        <item name="colorOnSecondary">@color/color_on_primary</item>
        <item name="colorSecondaryContainer">@color/color_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_primary_container</item>
        <item name="colorTertiary">@color/color_primary</item>
        <item name="colorOnTertiary">@color/color_on_primary</item>
        <item name="colorTertiaryContainer">@color/color_primary_container</item>
        <item name="colorOnTertiaryContainer">@color/color_on_primary_container</item>

        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>
        <item name="colorOnErrorContainer">@color/color_on_error_container</item>

        <item name="colorSurfaceInverse">@color/color_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/color_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/color_inverse_primary</item>
    </style>

    <style name="Theme.HomeAssistantApp" parent="Base.Theme.HomeAssistantApp" />
</resources>
